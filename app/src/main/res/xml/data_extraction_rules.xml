<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión cifrada con Android Keystore no debe respaldarse ni transferirse a otro dispositivo -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
