rules_version = '2';
// Registro de Tiempo de Personal — Reglas de seguridad de Cloud Firestore
// Autor: Juan Abel Reyna Gonzales — Ingeniero Industrial
//
// Basadas en CLAUDE.md §6.2.3, endurecidas para:
//  - impedir que un usuario cree su perfil como ADMINISTRADOR de otra empresa,
//  - validar el Código de Administrador al vincular colaboradores,
//  - aplicar el rate limiting de 60 s entre marcajes (campo usuarios.ultimoMarcaje),
//  - exigir rostro solo al iniciar turno (Ingreso y Fin de Descanso); salidas sin rostro,
//  - permitir al empleador registrar la salida de sus colaboradores (registradoPorAdmin),
//  - permitir dar de baja / desvincular colaboradores y eliminar cuentas (propia, de un colaborador por su admin y empresa completa),
//  - cubrir las colecciones codigos, justificaciones y alertas.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function getUserData() {
      return get(userPath()).data;
    }

    function isAdminOfCompany(companyAdminId) {
      return isAuthenticated()
        && getUserData().rol == 'ADMINISTRADOR'
        && getUserData().adminId == companyAdminId;
    }

    // Borrado masivo de datos de asistencia: solo mientras la empresa se está eliminando
    function empresaEnEliminacion(adminId) {
      return isAdminOfCompany(adminId)
        && get(/databases/$(database)/documents/empresas/$(adminId)).data.get('eliminando', false) == true;
    }

    // Registro (marcaje, justificación o alerta) de alguien que ya no pertenece al equipo del admin:
    // su perfil fue eliminado o está vinculado a otra empresa. Solo así el admin puede borrar ese historial.
    function deExColaborador(d) {
      return isAdminOfCompany(d.adminId) && (
        !exists(/databases/$(database)/documents/usuarios/$(d.colaboradorId))
        || get(/databases/$(database)/documents/usuarios/$(d.colaboradorId)).data.adminId != d.adminId
      );
    }

    // Foto de perfil: JPEG 320×320 en Base64 guardado en el perfil (sin Firebase Storage); tope de tamaño.
    function fotoValida() {
      return !('foto' in request.resource.data)
        || (request.resource.data.foto is string && request.resource.data.foto.size() <= 200000);
    }

    // ---------- Usuarios y perfiles ----------
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdminOfCompany(resource.data.adminId)
      );

      // Admin: solo puede ser administrador de su propia empresa (adminId == su uid).
      // Colaborador: el adminId debe coincidir con el Código de Administrador ingresado
      // y no puede fijarse tarifas ni régimen.
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        (request.resource.data.rol == 'ADMINISTRADOR'
          && request.resource.data.adminId == request.auth.uid)
        ||
        (request.resource.data.rol == 'COLABORADOR'
          && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigoVinculo))
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigoVinculo)).data.adminId
               == request.resource.data.adminId
          && !request.resource.data.keys().hasAny(['configPago', 'tarifaPorHora', 'regimenLaboral', 'ultimoMarcaje', 'horario'])
          // Documento con dígitos exactos (DNI 8, Carnet de Extranjería 9) y celular peruano de 9 dígitos
          && ((request.resource.data.tipoDocumento == 'DNI' && request.resource.data.dni.matches('[0-9]{8}'))
              || (request.resource.data.tipoDocumento == 'CE' && request.resource.data.dni.matches('[0-9]{9}')))
          && request.resource.data.telefono.matches('9[0-9]{8}'))
      );

      allow update: if isAuthenticated() && fotoValida() && (
        // El Admin edita a su equipo; solo puede mantener su adminId o desvincular (adminId = '')
        (isAdminOfCompany(resource.data.adminId)
          && request.resource.data.adminId in [resource.data.adminId, '']) ||
        // Colaborador desvinculado que se une a otra empresa con un Código de Administrador válido
        (request.auth.uid == userId
          && resource.data.rol == 'COLABORADOR'
          && resource.data.adminId == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminId', 'codigoVinculo', 'activo'])
          && request.resource.data.activo == true
          && exists(/databases/$(database)/documents/codigos/$(request.resource.data.codigoVinculo))
          && get(/databases/$(database)/documents/codigos/$(request.resource.data.codigoVinculo)).data.adminId
               == request.resource.data.adminId) ||
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['rol', 'adminId', 'tarifaPorHora', 'regimenLaboral', 'configPago', 'activo', 'horario', 'horaIngresoEsperada', 'dni', 'tipoDocumento'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['telefono'])
              || request.resource.data.telefono == '' || request.resource.data.telefono.matches('9[0-9]{8}'))
          // ultimoMarcaje solo puede fijarse a la hora del servidor
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoMarcaje'])
              || request.resource.data.ultimoMarcaje == request.time))
      );

      // Cada usuario elimina su propio perfil; el admin puede eliminar el de un colaborador de su equipo
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId
        || (resource.data.rol == 'COLABORADOR' && isAdminOfCompany(resource.data.adminId))
      );
    }

    // ---------- Códigos de Administrador (ADM-XXXX-X) ----------
    match /codigos/{codigo} {
      allow get: if isAuthenticated();
      allow list: if false; // evita enumerar códigos
      allow create: if isAuthenticated()
        && request.resource.data.adminId == request.auth.uid
        && codigo.matches('ADM-[0-9]{4}-[A-Z]');
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.adminId == request.auth.uid;
    }

    // ---------- Empresas, geocercas y plan (FREE / VIP) ----------
    match /empresas/{adminId} {
      allow read: if isAuthenticated() && getUserData().adminId == adminId;
      allow create: if isAuthenticated() && request.auth.uid == adminId
        && request.resource.data.plan == 'FREE';
      // El Admin no puede auto-asignarse plan VIP desde el cliente
      allow update: if isAuthenticated() && request.auth.uid == adminId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'vipExpiraEn', 'fechaCreacion', 'codigoAdministrador']);
      allow delete: if isAuthenticated() && request.auth.uid == adminId;
    }

    // ---------- Ex colaboradores (desvinculados o con cuenta eliminada): copia para los reportes ----------
    match /empresas/{adminId}/exColaboradores/{exId} {
      allow read, update, delete: if isAdminOfCompany(adminId);
      allow create: if isAdminOfCompany(adminId)
        || (isAuthenticated() && request.auth.uid == exId && getUserData().adminId == adminId);
    }

    // ---------- Marcajes (inmutables para el colaborador) ----------
    match /marcajes/{marcajeId} {
      allow read: if isAuthenticated() && (
        resource.data.colaboradorId == request.auth.uid ||
        isAdminOfCompany(resource.data.adminId)
      );

      // Marcaje del propio colaborador: hora oficial del servidor.
      // Rostro obligatorio solo al iniciar turno mañana (INGRESO) y tarde (FIN_DESCANSO).
      allow create: if isAuthenticated()
        && request.resource.data.colaboradorId == request.auth.uid
        && request.resource.data.adminId == getUserData().adminId
        && getUserData().activo != false
        && request.resource.data.timestamp == request.time
        && request.resource.data.tipo in ['INGRESO', 'INICIO_DESCANSO', 'FIN_DESCANSO', 'SALIDA']
        && request.resource.data.get('registradoPorAdmin', false) == false
        && (request.resource.data.validacionFacial == true
            || request.resource.data.tipo in ['INICIO_DESCANSO', 'SALIDA'])
        // Rate limiting: el mismo lote debe actualizar ultimoMarcaje y han pasado ≥ 60 s del anterior
        && getAfter(userPath()).data.ultimoMarcaje == request.time
        && (!('ultimoMarcaje' in getUserData())
            || request.time > getUserData().ultimoMarcaje + duration.value(60, 's'));

      // Salida registrada por el empleador para un colaborador de su empresa (hora no futura).
      allow create: if isAdminOfCompany(request.resource.data.adminId)
        && request.resource.data.tipo == 'SALIDA'
        && request.resource.data.registradoPorAdmin == true
        && request.resource.data.registradoPor == request.auth.uid
        && request.resource.data.validacionFacial == false
        && request.resource.data.timestamp is timestamp
        && request.resource.data.timestamp <= request.time
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.colaboradorId)).data.adminId
           == request.resource.data.adminId;

      allow update: if isAdminOfCompany(resource.data.adminId);
      // Solo al eliminar la empresa o el historial de un ex colaborador
      allow delete: if empresaEnEliminacion(resource.data.adminId) || deExColaborador(resource.data);
    }

    // ---------- Justificaciones de incidencias ----------
    match /justificaciones/{id} {
      allow read: if isAuthenticated() && (
        resource.data.colaboradorId == request.auth.uid ||
        isAdminOfCompany(resource.data.adminId)
      );
      allow create: if isAuthenticated()
        && request.resource.data.colaboradorId == request.auth.uid
        && request.resource.data.adminId == getUserData().adminId
        && request.resource.data.estado == 'PENDIENTE';
      allow update: if isAdminOfCompany(resource.data.adminId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'resuelto']);
      allow delete: if empresaEnEliminacion(resource.data.adminId) || deExColaborador(resource.data);
    }

    // ---------- Descuentos aplicados por el empleador ----------
    // Solo el administrador de la empresa los crea (a un colaborador de su equipo) o los anula;
    // el colaborador únicamente puede leer los suyos.
    match /descuentos/{id} {
      allow read: if isAuthenticated() && (
        resource.data.colaboradorId == request.auth.uid ||
        isAdminOfCompany(resource.data.adminId)
      );
      allow create: if isAdminOfCompany(request.resource.data.adminId)
        && request.resource.data.aplicadoPor == request.auth.uid
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.concepto is string
        && request.resource.data.concepto.size() > 0
        && request.resource.data.concepto.size() <= 80
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() <= 300
        && request.resource.data.creado == request.time
        && get(/databases/$(database)/documents/usuarios/$(request.resource.data.colaboradorId)).data.adminId
           == request.resource.data.adminId;
      allow update: if false;
      allow delete: if isAdminOfCompany(resource.data.adminId);
    }

    // ---------- Alertas antifraude / geocerca ----------
    match /alertas/{id} {
      allow read: if isAdminOfCompany(resource.data.adminId);
      allow create: if isAuthenticated()
        && request.resource.data.colaboradorId == request.auth.uid
        && request.resource.data.adminId == getUserData().adminId;
      allow update: if false;
      allow delete: if empresaEnEliminacion(resource.data.adminId) || deExColaborador(resource.data);
    }
  }
}
